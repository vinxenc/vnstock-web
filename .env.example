# URL of the AG-UI (Agent-User Interaction) backend the CopilotKit runtime proxies to.
# Server-side only (NOT prefixed with NEXT_PUBLIC_). Defaults to the value below.
AG_UI_BACKEND_URL=http://127.0.0.1:7933

# CopilotKit's runtime sends anonymous telemetry by default and logs a disclosure
# line on boot. Set this to opt out.
# COPILOTKIT_TELEMETRY_DISABLED=true
